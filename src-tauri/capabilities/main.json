{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Director window: runs every command and listens to tournament changes.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-tournaments",
    "allow-create-tournament",
    "allow-delete-tournament",
    "allow-get-view",
    "allow-dispatch",
    "allow-quote-deal",
    "allow-open-display-window",
    "allow-save-export",
    "allow-legacy-import-status",
    "allow-import-legacy"
  ]
}
