{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Director window: listens to state updates and runs the app's commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-create-tournament",
    "allow-reset-tournament",
    "allow-register-player",
    "allow-register-player-at-seat",
    "allow-eliminate-player",
    "allow-revive-player-at-seat",
    "allow-move-player",
    "allow-balance-suggestions",
    "allow-close-table",
    "allow-clock-start",
    "allow-clock-pause",
    "allow-clock-next",
    "allow-clock-prev",
    "allow-clock-adjust",
    "allow-clock-trigger-break",
    "allow-update-itm",
    "allow-undo-last-event",
    "allow-open-display-window",
    "allow-save-export"
  ]
}
