{
  "name": "freezeout to a winner",
  "seed": 42,
  "tournament": {
    "id": "freezeout",
    "config": {
      "name": "Friday freezeout",
      "seatsPerTable": 6,
      "maxTables": 1,
      "startingStack": 10000,
      "placesPaid": 3
    },
    "structure": [
      { "type": "play", "sb": 25, "bb": 50, "durationMs": 1200000 },
      { "type": "play", "sb": 50, "bb": 100, "durationMs": 1200000 },
      { "type": "break", "durationMs": 600000 },
      { "type": "play", "sb": 100, "bb": 200, "ante": { "type": "big_blind", "amount": 200 }, "durationMs": 1200000 }
    ]
  },
  "steps": [
    { "atMs": 1000, "cmd": { "type": "register", "name": "Alice", "seat": { "table": 1, "seat": 1 } } },
    { "atMs": 2000, "cmd": { "type": "register", "name": "Bob", "seat": { "table": 1, "seat": 2 } } },
    { "atMs": 3000, "cmd": { "type": "register", "name": " alice " }, "expect": { "error": "NAME_TAKEN" } },
    { "atMs": 3000, "cmd": { "type": "register", "name": "Carol" } },
    { "atMs": 4000, "cmd": { "type": "register", "name": "Dave" } },
    { "atMs": 5000, "cmd": { "type": "register", "name": "Eve" } },
    { "atMs": 6000, "cmd": { "type": "register", "name": "Frank" } },
    { "atMs": 7000, "cmd": { "type": "register", "name": "Grace" }, "expect": { "error": "TOURNAMENT_FULL" } },
    { "atMs": 8000, "cmd": { "type": "bust_players", "busts": [{ "player": 1 }] }, "expect": { "error": "NOT_STARTED" } },
    {
      "atMs": 10000,
      "cmd": { "type": "start_clock" },
      "view": {
        "phase": "running",
        "counts": { "unique": 6, "entries": 6, "alive": 6, "busted": 0 },
        "chips": { "startingStack": 10000, "inPlay": 60000, "avgStack": 10000, "avgStackBbX100": 20000 },
        "itm": { "status": "not_yet", "toMoney": 3 },
        "clock": { "levelIndex": 0, "playLevel": 1, "running": true, "remainingMs": 1200000, "endsAtMs": 1210000 }
      }
    },
    {
      "atMs": 60000,
      "cmd": { "type": "bust_players", "busts": [{ "player": 1 }] },
      "view": { "itm": { "status": "not_yet", "toMoney": 2 }, "chips": { "avgStack": 12000 } }
    },
    {
      "atMs": 120000,
      "cmd": { "type": "bust_players", "busts": [{ "player": 2 }] },
      "view": { "itm": { "status": "bubble" } }
    },
    {
      "atMs": 180000,
      "cmd": { "type": "bust_players", "busts": [{ "player": 3 }, { "player": 4 }] },
      "view": {
        "itm": { "status": "in_money" },
        "phase": "running",
        "warnings": []
      }
    },
    { "atMs": 200000, "cmd": { "type": "bust_players", "busts": [{ "player": 5 }, { "player": 6 }] }, "expect": { "error": "LAST_PLAYER_STANDING" } },
    { "atMs": 210000, "cmd": { "type": "close_registration" } },
    { "atMs": 220000, "cmd": { "type": "register", "name": "Grace" }, "expect": { "error": "LATE_REG_CLOSED" } },
    {
      "atMs": 240000,
      "cmd": { "type": "bust_players", "busts": [{ "player": 5 }] },
      "view": {
        "phase": "finished",
        "winner": 6,
        "clock": { "running": false, "remainingMs": 970000 }
      }
    },
    { "atMs": 250000, "cmd": { "type": "start_clock" }, "expect": { "error": "TOURNAMENT_FINISHED" } },
    { "atMs": 260000, "cmd": { "type": "undo" }, "view": { "phase": "running", "history": { "redo": { "kind": "players_busted", "names": ["Eve"] } } } },
    { "atMs": 270000, "cmd": { "type": "redo" }, "view": { "phase": "finished" } }
  ],
  "checks": [
    {
      "nowMs": 3600000,
      "view": {
        "phase": "finished",
        "winner": 6,
        "clock": { "running": false, "remainingMs": 970000 },
        "ranking": [
          { "name": "Frank", "place": 1, "placeTo": null, "provisional": false, "inMoney": true },
          { "name": "Eve", "place": 2, "placeTo": null, "inMoney": true },
          { "name": "Carol", "place": 3, "placeTo": 4, "inMoney": true },
          { "name": "Dave", "place": 3, "placeTo": 4, "inMoney": true },
          { "name": "Bob", "place": 5, "inMoney": false },
          { "name": "Alice", "place": 6, "inMoney": false }
        ]
      }
    }
  ]
